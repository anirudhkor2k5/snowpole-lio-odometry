+namespace {
+// lio_bench: number of stationary IMU samples averaged for the initial gravity / gyro bias.
+// Upstream uses kInitScanCount (20 samples = 0.2 s at 100 Hz); GENZ_INIT_IMU_SAMPLES overrides it.
+int initImuSamples(int fallback) {
+    static const int n = [fallback] {
+        const char *e = std::getenv("GENZ_INIT_IMU_SAMPLES");
+        return (e && std::atoi(e) > 0) ? std::atoi(e) : fallback;
+    }();
+    return n;
+}
